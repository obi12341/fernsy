<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Apple TV app's keys next to the generated ones; the same ATS exception as the Mac
	     (Config/Info.plist): Xtream servers, their stream redirects and Jellyfin in the home
	     network are plain HTTP.
	     Do not add NSAllowsArbitraryLoadsForMedia: it makes ATS ignore NSAllowsArbitraryLoads. -->
	<!-- Fernsy Cloud shows only with FERNSY_CLOUD = YES (add-recording-cloud design H). -->
	<key>FernsyCloud</key>
	<string>$(FERNSY_CLOUD)</string>
	<!-- Only standard HTTPS/TLS from the system: exempt from export documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Fernsy connects to your Jellyfin server or IPTV provider on your local network.</string>
	<!-- Deep links from the Top Shelf (tvos-top-shelf): fernsy:// in release builds, fernsy-dev://
	     in debug builds (FERNSY_URL_SCHEME), so each opens its own app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(FERNSY_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
