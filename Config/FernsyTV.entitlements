<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud sync (icloud-sync): settings in the key-value store, logins in CloudKit. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
	<!-- App Store validation: tvOS apps with CloudKit need the push entitlement (CloudKit's
	     change notifications). Signing for the store turns it into "production". -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Shared with the Top Shelf extension (tvos-top-shelf design 5): the snapshot and its images. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
