<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xtream servers and their stream redirects are plain HTTP.
	     Do not add NSAllowsArbitraryLoadsForMedia: it makes ATS ignore NSAllowsArbitraryLoads. -->
	<!-- Only standard HTTPS/TLS from the system: exempt from export documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Fernsy connects to your Jellyfin server or IPTV provider on your local network.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Fernsy Cloud shows only with FERNSY_CLOUD = YES (add-recording-cloud design H). -->
	<key>FernsyCloud</key>
	<string>$(FERNSY_CLOUD)</string>
</dict>
</plist>
