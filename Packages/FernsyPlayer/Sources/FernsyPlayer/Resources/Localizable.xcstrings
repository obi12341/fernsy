        }
      }
    },
    "The recording could not be written fast enough": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme konnte nicht schnell genug geschrieben werden"
          }
        }
      }
    },
    "This channel is currently offline at your provider.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sender ist beim Anbieter derzeit offline."
          }
        }
      }
    },
    "Timeshift is not available for this channel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitversetztes Fernsehen ist für diesen Sender nicht möglich."
          }
        }
      }
    },
    "To record, Fernsy switches to %@, because your account allows only %lld stream(s) at a time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Aufnahme schaltet Fernsy auf %1$@ um, weil dein Zugang nur %2$lld Stream(s) gleichzeitig erlaubt."
          }
        }
      }
    },
    "Track %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spur %lld"
          }
        }
      }
    },
