      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VideoToolbox (Dolby Vision)"
          }
        }
      }
    },
    "Without an answer, the recording starts in one minute.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Antwort startet die Aufnahme in einer Minute."
          }
        }
      }
    },
    "Your account allows %lld stream(s) at a time, so less extra time is possible:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Zugang erlaubt %lld Stream(s) gleichzeitig, deshalb ist weniger Puffer möglich:"
          }
        }
      }
    },
    "no data for %.0f s, %.1f s buffered": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "keine Daten seit %1$.0f s, %2$.1f s Vorrat"
          }
        }
      }
    },
    "no data for %1$.0f s, player nearly empty (%2$.1f s buffered)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "keine Daten seit %1$.0f s, Player fast leer (%2$.1f s Vorrat)"
          }
        }
      }
    },
    "no response": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "keine Antwort"
          }
        }
      }
    },
    "too slow: %1$.0f s of content in %2$.0f s": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "zu langsam: %.0f s Inhalt in %.0f s"
          }
        }
      }
    },
    "“%@” (%@)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ (%2$@)"
          }
        }
      }
    },
    "“%@” is being recorded on %@. Your account allows only %lld stream(s) at a time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade wird „%1$@“ auf %2$@ aufgenommen. Dein Zugang erlaubt nur %3$lld Stream(s) gleichzeitig."
          }
        }
      }
    },
    "“%@” is on at the same time as %@. Your account allows %lld stream(s) at a time. Remove one of these recordings to record this show.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ läuft zur selben Zeit wie %2$@. Dein Zugang erlaubt %3$lld Stream(s) gleichzeitig. Entferne eine dieser Aufnahmen, um diese Sendung aufzunehmen."
          }
        }
      }
    }
  },
  "version": "1.0"
}
