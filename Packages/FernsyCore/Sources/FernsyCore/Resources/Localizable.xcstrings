    "This device does not have the key for Fernsy Cloud yet. It comes from iCloud of the same Apple ID.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesem Gerät fehlt noch der Schlüssel für Fernsy Cloud. Er kommt aus der iCloud derselben Apple-ID."
          }
        }
      }
    },
    "Fernsy Cloud does not accept this device’s key. Please contact support.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fernsy Cloud nimmt den Schlüssel dieses Geräts nicht an. Bitte wende dich an den Support."
          }
        }
      }
    },
    "iCloud cannot be reached, so Fernsy Cloud is not available right now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist nicht erreichbar, deshalb ist Fernsy Cloud gerade nicht verfügbar."
