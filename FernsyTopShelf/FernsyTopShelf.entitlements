<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's App Group (tvos-top-shelf design 5): group.<app bundle id>, set per build
	     configuration in FERNSY_APP_GROUP, as the extension's own bundle id differs. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(FERNSY_APP_GROUP)</string>
	</array>
</dict>
</plist>
