        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies when playback starts, if the track exists. “Forced only” shows subtitles only for foreign-language passages. If you pick other tracks in the player during a series episode, Fernsy keeps them for the following episodes."
