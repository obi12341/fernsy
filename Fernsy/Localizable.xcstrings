{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "\"%@\" is being recorded on %@, and your account allows only %lld stream(s). So Fernsy doesn't switch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade wird „%1$@“ auf %2$@ aufgenommen, und dein Zugang erlaubt nur %3$lld Stream(s). Fernsy schaltet deshalb nicht um."
          }
        }
      }
    },
    "\"%@\" is on %@ on %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ kommt %2$@ auf %3$@."
          }
        }
      }
    },
    "\"%@\" will be recorded, %@ to %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ wird aufgenommen, %2$@ bis %3$@."
