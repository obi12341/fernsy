  "strings": {
    "${applicationName} auf ${channel}": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName} on ${channel}"
          }
        }
      }
    },
    "Aufnahme in ${applicationName} starten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start recording in ${applicationName}"
          }
        }
      }
    },
    "Beende die Wiedergabe in ${applicationName}": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop playback in ${applicationName}"
          }
        }
      }
    },
    "Nimm ${channel} in ${applicationName} auf": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record ${channel} in ${applicationName}"
          }
        }
      }
    },
    "Nimm das in ${applicationName} auf": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record this in ${applicationName}"
          }
        }
      }
