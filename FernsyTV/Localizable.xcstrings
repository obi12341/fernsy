    "A notification appears on your iPhone. With it you can type or paste the address and password.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem iPhone erscheint eine Mitteilung. Darüber kannst du Adresse und Passwort bequem eintippen oder einfügen."
          }
        }
      }
    },
    "Add IPTV Account": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "IPTV-Zugang hinzufügen"
          }
        }
      }
    },
    "Ended": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet"
          }
        }
      }
    },
    "Fernsy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fernsy"
          }
        }
      }
    },
    "Fernsy brings no content. You need your own account with a provider or a Jellyfin server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fernsy enthält keine Inhalte. Du brauchst einen eigenen Zugang bei einem Anbieter oder einen Jellyfin-Server."
          }
        }
      }
    },
