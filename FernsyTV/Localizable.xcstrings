    },
    "iCloud is not available. Sign in to iCloud in the Apple TV’s settings; until then Fernsy keeps this Apple TV’s settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist nicht verfügbar. Melde dich in den Einstellungen des Apple TV bei iCloud an; bis dahin behält Fernsy die Einstellungen dieses Apple TV."
          }
        }
      }
    },
