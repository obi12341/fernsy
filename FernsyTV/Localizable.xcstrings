      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fernsy"
          }
        }
      }
    },
    "Fernsy brings no content. You need your own account with a provider or a Jellyfin server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fernsy enthält keine Inhalte. Du brauchst einen eigenen Zugang bei einem Anbieter oder einen Jellyfin-Server."
          }
        }
      }
    },
    "Fernsy on Apple TV uses one IPTV account. To use another one, sign out first. Jellyfin servers follow in a later version.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fernsy nutzt auf Apple TV einen IPTV-Zugang. Für einen anderen meldest du dich zuerst ab. Jellyfin-Server folgen in einer späteren Version."
          }
        }
      }
    },
    "Fernsy uses one IPTV account and one Jellyfin server at a time; sign out to use another one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fernsy nutzt einen IPTV-Zugang und einen Jellyfin-Server zugleich; für andere meldest du dich zuerst ab."
