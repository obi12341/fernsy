    "Remove": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen"
          }
        }
      }
    },
    "Subscribe · %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnieren · %@"
          }
        }
      }
    },
    "Switches the TV to the frame rate and HDR mode of what plays from this server. The TV only switches when “Match Content” is on in the Apple TV’s Settings › Video and Audio.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet den Fernseher auf die Bildfrequenz und den HDR-Modus dessen um, was von diesem Server läuft. Der Fernseher schaltet nur um, wenn „Inhalt anpassen“ in den Einstellungen des Apple TV unter „Video und Audio“ eingeschaltet ist."
          }
        }
      }
    },
    "The assistant asks again before its next request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistent fragt vor seiner nächsten Anfrage wieder."
          }
        }
      }
    },
