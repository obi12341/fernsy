      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte in Live TV die Taste auf einem Sender gedrückt oder wähle im Programm eine Sendung, um sie aufzunehmen. Fernsy nimmt auf, solange es auf diesem Apple TV geöffnet ist; tvOS kann Aufnahmen löschen, wenn der Speicher knapp wird."
          }
        }
